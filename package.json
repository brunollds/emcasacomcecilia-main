{
  "name": "emcasacomcecilia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content/build-index.mjs && node scripts/content/validate-yesstyle-coupons.mjs && tsx scripts/test-review-discovery.ts && tsx scripts/validate-video-schema.ts && tsx scripts/test-internal-links.ts && tsx scripts/test-coupon-offer-modes.ts && tsx scripts/test-analytics-gate.ts && node scripts/test-image-hosts.mjs && tsx scripts/test-home-route-tracking.ts && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content-model.ts",
    "validate:video": "tsx scripts/validate-video-schema.ts",
    "validate:yesstyle": "node scripts/content/validate-yesstyle-coupons.mjs",
    "validate:pretext": "tsx scripts/validate-pretext.ts",
    "verify:release": "node scripts/content/verify-release-endpoint.mjs",
    "test:release-meta": "node scripts/content/release-identity.mjs --self-test",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "update:popular-recipes": "node scripts/update-popular-recipes.mjs",
    "youtube:inventory": "tsx data/youtube/youtube-inventory.ts",
    "youtube:match": "tsx data/youtube/youtube-recipe-matching.ts",
    "deploy:prepare": "node scripts/deploy/prepare.mjs",
    "deploy:finish": "node scripts/deploy/finish.mjs",
    "test:hostinger-wire": "node --test scripts/deploy/hostinger-managed-wire.test.mjs",
    "test:artifact-scan": "node --test scripts/deploy/scan-artifacts.test.mjs",
    "test:archive-size": "node --test scripts/deploy/check-archive-size.test.mjs",
    "test:deploy-guard": "node --test scripts/deploy/preflight.test.mjs scripts/deploy/prepare.test.mjs scripts/deploy/finish.test.mjs",
    "test:yesstyle-data": "node --test scripts/content/validate-yesstyle-coupons.test.mjs",
    "check:archive-size": "node scripts/deploy/check-archive-size.mjs",
    "test:coupon-offer-modes": "tsx scripts/test-coupon-offer-modes.ts",
    "test:internal-links": "tsx scripts/test-internal-links.ts",
    "test:analytics-gate": "tsx scripts/test-analytics-gate.ts",
    "test:image-hosts": "node scripts/test-image-hosts.mjs",
    "test:home-route-tracking": "tsx scripts/test-home-route-tracking.ts",
    "test:review-discovery": "tsx scripts/test-review-discovery.ts",
    "probe:hostinger-wire": "node scripts/deploy/hostinger-managed-wire.mjs --execute",
    "content:export": "tsx scripts/content/export-content.ts",
    "content:index": "node scripts/content/build-index.mjs",
    "test:html-lang": "tsx scripts/test-c2-html-lang.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tus-js-client": "^4.3.1"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  }
}
